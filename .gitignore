# Personal learning data - DO NOT commit
/data/*.json
/data/*.json.backup-*
/results/*.md
# Except the README files which explain the structure
!/data/README.md
!/results/README.md

# Personal writing/practice files
myfile.txt

# Backup files created by hooks
.backups/

# Keep directory structure but ignore contents
!/data/.gitkeep
!/results/.gitkeep

# System files
.DS_Store
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Python bytecode
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*

# Temp files
.tmp/
temp/
*.json.tmp


# Swift app build artifacts
/app/.build/
/app/Fluent.app/
/app/*.xcodeproj/
.swiftpm/

# Throwaway exploration scripts
_probes/

# imgbench keeps its measurements; the sample images are large and disposable
/tools/imgbench/samples/

# Secrets
.env
.env.*
!.env.example
